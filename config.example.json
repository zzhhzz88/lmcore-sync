{
  "base_url": "https://core.xjtlu.edu.cn",
  "browser": "msedge",
  "courses_root": "~/Desktop",
  "auto_courses": false,
  "layout_preset": "zh",
  "ascii_prefixes": [
    "EEE"
  ],
  "exclude": [],
  "request_delay": 0.3,
  "retries": 3,
  "courses": [
    {
      "match": "ABC123",
      "folder": "~/Desktop/abc123",
      "layout": "zh"
    }
  ],
  "extra_deadlines": []
}
